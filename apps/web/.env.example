# ─── GENX Cloud POS — Web (Vercel) Environment Variables ───────────────────────
#
# Copy this file to apps/web/.env for local development.
# In Vercel, set these as Environment Variables in the Vercel Dashboard.
# NEVER commit the real .env file with actual keys.
#
# Required for online authentication and data:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Point to your deployed API backend (Fastify)
# Leave empty to use Supabase directly for auth.
VITE_API_URL=https://your-api.vercel.app

# App version (shown in settings)
VITE_APP_VERSION=1.0.0
